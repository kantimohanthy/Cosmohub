<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#070a0f">
<title>CosmoHub — The Terminal & Ontology for the Space Economy</title>
<meta name="description" content="CosmoHub is an ontology-first intelligence platform connecting space research institutes, universities, and missions directly with talent — enthusiasts, students, and research fellows.">

<!-- Open Graph / Social Meta Tags -->
<meta property="og:type" content="website">
<meta property="og:title" content="CosmoHub — The Terminal for the Space Economy">
<meta property="og:description" content="An ontology-first intelligence platform matching space talent, research fellowships, and institutional missions.">
<meta property="og:url" content="https://kantimohanthy.github.io/cosmohub/">
<meta property="og:site_name" content="CosmoHub">

<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="CosmoHub — The Terminal for the Space Economy">
<meta name="twitter:description" content="Connecting space research institutes, universities, and missions directly with space talent.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#070a0f;
    --panel:#0e131d;
    --panel-alt:#141a27;
    --panel-hover:#1c2436;
    --border:#1f2738;
    --border-light:#2d384f;
    --amber:#ffb627;
    --amber-dim:#946d23;
    --cyan:#4ce0c6;
    --cyan-dim:#246e61;
    --blue:#3b82f6;
    --text:#f0f3f8;
    --muted:#828c9e;
    --red:#ff6b6b;
    --display:'Space Grotesk',sans-serif;
    --body:'IBM Plex Sans',sans-serif;
    --mono:'IBM Plex Mono',monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--body);
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--amber); color:#070a0f;}
  a{color:inherit; text-decoration:none;}
  button, input, select{font-family:inherit;}
  .wrap{max-width:1200px; margin:0 auto; padding:0 32px;}

  /*Accessibility & Focus Visibility */
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible{
    outline:2px solid var(--cyan); outline-offset:3px;
  }

  /*No-JS Notice */
  .noscript-banner{
    background:var(--amber); color:#070a0f; font-family:var(--mono); font-size:12px;
    font-weight:600; text-align:center; padding:10px 16px;
  }

  /*Topbar Navigation */
  .topbar{
    position:sticky; top:0; z-index:100;
    background:rgba(7,10,15,0.94);
    backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 32px; max-width:1200px; margin:0 auto;
  }
  .logo{
    font-family:var(--mono); font-weight:600; font-size:15px;
    letter-spacing:0.06em; display:flex; align-items:center; gap:10px;
  }
  .logo .dot{width:8px; height:8px; background:var(--amber); border-radius:50%; box-shadow:0 0 10px var(--amber);}
  .logo .badge{
    font-size:10px; font-weight:500; color:var(--cyan); border:1px solid var(--cyan-dim);
    padding:2px 6px; letter-spacing:0.05em; background:rgba(76,224,198,0.06);
  }
  .navlinks{display:flex; gap:28px; font-size:13px; color:var(--muted); font-family:var(--mono);}
  .navlinks a{transition:color .2s;}
  .navlinks a:hover{color:var(--text);}
  .nav-right{display:flex; align-items:center; gap:16px;}
  .nav-cta{
    font-family:var(--mono); font-size:12.5px; font-weight:500;
    padding:8px 16px; border:1px solid var(--amber); color:var(--amber);
    letter-spacing:0.04em; transition:all .2s; cursor:pointer; background:transparent;
  }
  .nav-cta:hover{background:var(--amber); color:#070a0f;}

  /*Mobile menu drawer */
  .mobile-menu-toggle{
    display:none; background:none; border:1px solid var(--border-light);
    color:var(--text); padding:6px 12px; font-family:var(--mono); font-size:12px; cursor:pointer;
  }
  .mobile-drawer{
    display:none; flex-direction:column; gap:14px; padding:20px 32px;
    background:var(--panel); border-bottom:1px solid var(--border); font-family:var(--mono); font-size:13px;
  }
  .mobile-drawer.active{display:flex;}

  @media (max-width:860px){
    .navlinks{display:none;}
    .mobile-menu-toggle{display:block;}
  }

  /*Ticker Bar */
  .ticker-bar{
    background:var(--panel);
    border-bottom:1px solid var(--border);
    overflow:hidden; white-space:nowrap; padding:8px 0;
  }
  .ticker-track{display:inline-flex; animation:scrollTicker 45s linear infinite;}
  .ticker-track span{
    font-family:var(--mono); font-size:12px; color:var(--muted);
    padding:0 24px; border-right:1px solid var(--border);
    display:inline-flex; align-items:center; gap:8px;
  }
  .ticker-track span b{color:var(--text); font-weight:500;}
  .up{color:var(--cyan);}
  .down{color:var(--red);}
  @keyframes scrollTicker{
    0%{transform:translateX(0);}
    100%{transform:translateX(-50%);}
  }

  /*Hero Section */
  .hero{
    position:relative; padding:80px 0 70px;
    border-bottom:1px solid var(--border); overflow:hidden;
  }
  .hero-grid{display:grid; grid-template-columns:1.15fr 0.85fr; gap:50px; align-items:center;}
  @media (max-width:960px){.hero-grid{grid-template-columns:1fr;}}
  .eyebrow{
    font-family:var(--mono); color:var(--amber); font-size:12px;
    letter-spacing:0.14em; text-transform:uppercase;
    display:flex; align-items:center; gap:10px; margin-bottom:20px;
  }
  .eyebrow::before{content:''; width:20px; height:1px; background:var(--amber);}
  h1{
    font-family:var(--display); font-weight:700;
    font-size:clamp(36px,5vw,60px); line-height:1.06;
    letter-spacing:-0.01em; margin-bottom:22px;
  }
  h1 .accent{color:var(--amber);}
  .hero-sub{font-size:16.5px; color:var(--muted); max-width:540px; margin-bottom:32px;}
  .hero-sub b{color:var(--text); font-weight:500;}
  .hero-ctas{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:38px;}
  .btn-primary{
    font-family:var(--mono); font-size:13px; font-weight:500;
    background:var(--amber); color:#070a0f; border:1px solid var(--amber);
    padding:12px 22px; letter-spacing:0.03em; cursor:pointer;
    transition:transform .15s, box-shadow .2s; display:inline-block; text-align:center;
  }
  .btn-primary:hover{transform:translateY(-1px); box-shadow:0 6px 20px rgba(255,182,39,0.25);}
  .btn-ghost{
    font-family:var(--mono); font-size:13px; font-weight:500;
    background:transparent; color:var(--text); border:1px solid var(--border-light);
    padding:12px 22px; letter-spacing:0.03em; cursor:pointer;
    transition:border-color .2s, color .2s; display:inline-block; text-align:center;
  }
  .btn-ghost:hover{border-color:var(--cyan); color:var(--cyan);}

  .metrics-strip{
    display:grid; grid-template-columns:repeat(4,1fr); gap:16px;
    background:var(--panel); border:1px solid var(--border); padding:16px 20px;
  }
  @media (max-width:600px){.metrics-strip{grid-template-columns:repeat(2,1fr);}}
  .met-item{display:flex; flex-direction:column;}
  .met-label{font-family:var(--mono); font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:0.06em;}
  .met-val{font-family:var(--mono); font-size:18px; font-weight:600; color:var(--text); margin-top:2px;}
  .met-val.amber{color:var(--amber);}
  .met-val.cyan{color:var(--cyan);}

  /*Orbital Visualizer */
  .orbit-wrap{
    position:relative; height:400px; display:flex; align-items:center; justify-content:center;
    background:radial-gradient(circle at center, rgba(76,224,198,0.05) 0%, transparent 70%);
  }
  .orbit-svg{width:100%; height:100%; max-width:400px;}
  .orbit-ring{fill:none; stroke:var(--border-light); stroke-width:1;}
  .orbit-ring.active{stroke:var(--amber-dim); stroke-dasharray:4 4;}
  .sat{fill:var(--amber); transition:all .3s; cursor:pointer;}
  .sat:hover{r:7; fill:#ffffff; filter:drop-shadow(0 0 8px var(--amber));}
  .sat.cyan{fill:var(--cyan);}
  .sat.cyan:hover{fill:#ffffff; filter:drop-shadow(0 0 8px var(--cyan));}
  .orbit-group{transform-origin:200px 200px;}
  .orbit-group.r1{animation:spin 20s linear infinite;}
  .orbit-group.r2{animation:spin 32s linear infinite reverse;}
  .orbit-group.r3{animation:spin 46s linear infinite;}
  @keyframes spin{ to{transform:rotate(360deg);} }
  .orbit-center-label{font-family:var(--mono); font-size:11px; fill:var(--text); letter-spacing:0.1em;}
  .orbit-sub-label{font-family:var(--mono); font-size:8.5px; fill:var(--amber); letter-spacing:0.08em;}

  /*Section Commons */
  .section{padding:80px 0; border-bottom:1px solid var(--border);}
  .section-head{margin-bottom:44px; max-width:680px;}
  .section-head .eyebrow{margin-bottom:12px;}
  h2{
    font-family:var(--display); font-weight:700;
    font-size:clamp(26px,3.4vw,38px); line-height:1.14; margin-bottom:14px;
  }
  .section-head p{color:var(--muted); font-size:15.5px;}

  /*Gap Section */
  .gap-toggle-bar{display:flex; justify-content:center; gap:12px; margin-bottom:32px; font-family:var(--mono); font-size:12px;}
  .gap-btn{padding:8px 16px; border:1px solid var(--border-light); background:var(--panel); color:var(--muted); cursor:pointer; transition:all .2s;}
  .gap-btn.active{border-color:var(--amber); color:var(--amber); background:rgba(255,182,39,0.08);}

  .gap-visualizer{
    display:grid; grid-template-columns:1fr 140px 1fr; align-items:center; gap:20px;
    background:var(--panel); border:1px solid var(--border); padding:36px;
  }
  @media (max-width:760px){
    .gap-visualizer{grid-template-columns:1fr; text-align:center;}
    .gap-arrow{transform:rotate(90deg); margin:12px 0;}
  }
  .gap-card{background:var(--bg); border:1px solid var(--border-light); padding:24px;}
  .gap-card h4{font-family:var(--display); font-size:18px; margin-bottom:8px; color:var(--text);}
  .gap-card p{font-size:13.5px; color:var(--muted);}
  .gap-arrow{
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
    font-family:var(--mono); font-size:10.5px; color:var(--amber); text-align:center;
  }
  .gap-line{width:100%; height:1px; background:linear-gradient(90deg,transparent,var(--amber),transparent);}

  /*Audiences Section */
  .grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  @media (max-width:900px){.grid-3{grid-template-columns:1fr;}}
  .card-term{
    background:var(--panel); border:1px solid var(--border);
    display:flex; flex-direction:column; justify-content:space-between;
    transition:border-color .2s, transform .2s;
  }
  .card-term:hover{border-color:var(--border-light); transform:translateY(-2px);}
  .term-head{
    display:flex; justify-content:space-between; align-items:center;
    padding:12px 18px; border-bottom:1px solid var(--border);
    font-family:var(--mono); font-size:11px; color:var(--muted);
  }
  .term-head .code{color:var(--amber);}
  .term-body{padding:24px 20px;}
  .term-body h3{font-family:var(--display); font-size:20px; font-weight:600; margin-bottom:10px;}
  .term-body p{color:var(--muted); font-size:14px; margin-bottom:18px;}
  .term-tags{display:flex; gap:8px; flex-wrap:wrap;}
  .term-tags span{
    font-family:var(--mono); font-size:10.5px; color:var(--cyan);
    border:1px solid rgba(76,224,198,0.25); background:rgba(76,224,198,0.04);
    padding:3px 8px;
  }

  /*Space Intelligence Section */
  .intel-toolbar{display:flex; justify-content:space-between; gap:16px; align-items:center; flex-wrap:wrap; margin-bottom:24px;}
  .intel-tabs{display:flex; gap:8px; flex-wrap:wrap;}
  .intel-tab{font-family:var(--mono); font-size:11.5px; padding:8px 14px; border:1px solid var(--border-light); background:var(--panel); color:var(--muted); cursor:pointer; transition:all .2s;}
  .intel-tab.active, .intel-tab:hover{border-color:var(--amber); color:var(--amber); background:rgba(255,182,39,0.06);}
  .intel-status{font-family:var(--mono); font-size:11px; color:var(--cyan);}
  .intel-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px;}
  @media(max-width:980px){.intel-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:640px){.intel-grid{grid-template-columns:1fr;}}

  .intel-card{
    background:var(--panel); border:1px solid var(--border); padding:22px;
    display:flex; flex-direction:column; justify-content:space-between; min-height:245px; transition:all .2s; cursor:pointer;
  }
  .intel-card:hover{border-color:var(--border-light); transform:translateY(-2px); background:var(--panel-hover);}
  .intel-meta{display:flex; justify-content:space-between; gap:12px; font-family:var(--mono); font-size:10px; color:var(--muted); margin-bottom:14px; text-transform:uppercase; letter-spacing:.04em;}
  .intel-source{color:var(--cyan);}
  .intel-card h3{font-family:var(--display); font-size:18px; line-height:1.25; margin-bottom:10px; color:var(--text);}
  .intel-card p{font-size:13.5px; color:var(--muted); margin-bottom:20px; flex:1; line-height:1.5;}
  .intel-link{font-family:var(--mono); font-size:11.5px; color:var(--amber); display:inline-flex; align-items:center; gap:4px;}
  .intel-empty{grid-column:1/-1; border:1px dashed var(--border-light); padding:34px; text-align:center; color:var(--muted); font-family:var(--mono); font-size:12px;}
  .source-strip{display:flex; gap:10px; flex-wrap:wrap; margin-top:22px;}
  .source-pill{font-family:var(--mono); font-size:10.5px; color:var(--muted); border:1px solid var(--border); padding:5px 9px; background:rgba(255,255,255,0.02);}

  /*Interactive Ontology Graph Visualizer */
  .ontology-container{
    background:var(--panel); border:1px solid var(--border);
    display:grid; grid-template-columns:1.3fr 0.7fr; gap:0; min-height:480px; overflow:hidden;
  }
  @media (max-width:900px){.ontology-container{grid-template-columns:1fr;}}
  .ontology-canvas-wrap{
    position:relative; background:var(--bg); border-right:1px solid var(--border);
    padding:20px; display:flex; align-items:center; justify-content:center;
  }
  .ontology-svg{width:100%; height:100%; max-height:440px;}
  .node-group{cursor:pointer;}
  .node-circle{transition:all .3s;}
  .node-group:hover .node-circle{r:24; filter:drop-shadow(0 0 10px var(--amber));}
  .node-text{font-family:var(--mono); font-size:11px; fill:var(--text); pointer-events:none; font-weight:600;}
  .node-sub{font-family:var(--mono); font-size:9px; fill:var(--muted); pointer-events:none;}
  .edge-line{stroke:var(--border-light); stroke-width:1.5; stroke-dasharray:4 2; transition:all .3s;}
  .edge-line.active{stroke:var(--amber); stroke-width:2.5; stroke-dasharray:none; filter:drop-shadow(0 0 6px var(--amber));}

  .ontology-inspector{padding:28px 24px; display:flex; flex-direction:column; justify-content:space-between;}
  .inspector-header{
    font-family:var(--mono); font-size:11px; color:var(--amber); text-transform:uppercase;
    letter-spacing:0.08em; margin-bottom:12px; display:flex; align-items:center; justify-content:space-between;
  }
  .inspector-title{font-family:var(--display); font-size:22px; font-weight:700; color:var(--text); margin-bottom:8px;}
  .inspector-desc{font-size:13.5px; color:var(--muted); margin-bottom:20px; line-height:1.5;}
  .inspector-prop-table{width:100%; border-collapse:collapse; font-family:var(--mono); font-size:11.5px; margin-bottom:20px;}
  .inspector-prop-table td{padding:8px 0; border-bottom:1px solid var(--border);}
  .inspector-prop-table td.key{color:var(--muted); width:40%;}
  .inspector-prop-table td.val{color:var(--cyan); font-weight:500;}

  /*Board Tracks */
  .board-filter{display:flex; gap:10px; margin-bottom:28px; flex-wrap:wrap;}
  .filter-chip{
    font-family:var(--mono); font-size:11.5px; padding:6px 14px; border:1px solid var(--border-light);
    background:var(--panel); color:var(--muted); cursor:pointer; transition:all .2s;
  }
  .filter-chip.active, .filter-chip:hover{border-color:var(--amber); color:var(--amber); background:rgba(255,182,39,0.06);}

  .index-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:16px;}
  @media (max-width:1000px){.index-grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:540px){.index-grid{grid-template-columns:1fr;}}

  .idx-card{
    background:var(--panel-alt); border:1px solid var(--border);
    padding:20px; transition:all .2s; cursor:pointer; position:relative; overflow:hidden;
  }
  .idx-card:hover{border-color:var(--amber-dim); background:var(--panel-hover); transform:translateY(-2px);}
  .idx-top{display:flex; justify-content:space-between; align-items:baseline; margin-bottom:10px;}
  .idx-code{font-family:var(--mono); font-weight:600; font-size:14px; color:var(--text);}
  .idx-signal{
    font-family:var(--mono); font-size:10px; letter-spacing:0.05em; padding:3px 7px;
    border:1px solid var(--border); font-weight:500;
  }
  .idx-signal.high{color:var(--cyan); border-color:rgba(76,224,198,0.35); background:rgba(76,224,198,0.05);}
  .idx-signal.rising{color:var(--amber); border-color:rgba(255,182,39,0.35); background:rgba(255,182,39,0.05);}
  .idx-name{font-size:13px; color:var(--muted); margin-bottom:16px; min-height:36px;}
  .idx-spark{width:100%; height:32px;}
  .idx-spark path{fill:none; stroke-width:1.8;}

  /*Roadmap */
  .roadmap-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
  @media (max-width:840px){.roadmap-grid{grid-template-columns:1fr;}}
  .phase-card{background:var(--panel); border:1px solid var(--border); padding:28px 24px;}
  .phase-num{font-family:var(--mono); font-size:11px; color:var(--amber); letter-spacing:0.1em; margin-bottom:12px;}
  .phase-card h3{font-family:var(--display); font-size:18px; font-weight:600; margin-bottom:10px;}
  .phase-card p{font-size:13.5px; color:var(--muted); margin-bottom:16px;}
  .phase-ul{list-style:none; font-family:var(--mono); font-size:11.5px; color:var(--text);}
  .phase-ul li{margin-bottom:8px; display:flex; align-items:center; gap:8px;}
  .phase-ul li::before{content:'›'; color:var(--cyan); font-weight:bold;}

  /*Access Form */
  .cta-panel{
    background:var(--panel); border:1px solid var(--border); padding:48px;
    display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;
  }
  @media (max-width:860px){.cta-panel{grid-template-columns:1fr; padding:32px 24px;}}
  .form-row{display:flex; flex-direction:column; gap:16px;}
  .form-field label{
    font-family:var(--mono); font-size:11px; color:var(--muted);
    letter-spacing:0.06em; text-transform:uppercase; margin-bottom:6px; display:block;
  }
  .form-field input, .form-field select{
    width:100%; background:var(--bg); border:1px solid var(--border-light);
    color:var(--text); padding:12px 14px; font-size:14px; outline:none; transition:border-color .2s;
  }
  .form-field input:focus, .form-field select:focus{border-color:var(--amber);}
  .submit-btn{
    font-family:var(--mono); font-size:13px; font-weight:600;
    background:var(--amber); color:#070a0f; border:1px solid var(--amber);
    padding:14px; letter-spacing:0.03em; cursor:pointer; transition:all .2s; margin-top:8px;
  }
  .submit-btn:hover{background:#ffa800; transform:translateY(-1px);}
  .form-note{font-family:var(--mono); font-size:11px; color:var(--muted); margin-top:10px;}
  .form-success{
    display:none; font-family:var(--mono); font-size:13px; color:var(--cyan);
    border:1px solid rgba(76,224,198,0.4); background:rgba(76,224,198,0.06); padding:14px; margin-top:14px;
  }

  /*Modal Backdrop & Box */
  .modal-backdrop{
    position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85);
    backdrop-filter:blur(8px); z-index:200; display:none; align-items:center; justify-content:center; padding:20px;
  }
  .modal-box{
    background:var(--panel); border:1px solid var(--border-light); max-width:560px; width:100%;
    padding:32px; position:relative; box-shadow:0 20px 40px rgba(0,0,0,0.6);
  }
  .modal-close{
    position:absolute; top:16px; right:16px; background:none; border:none; color:var(--muted);
    font-family:var(--mono); font-size:22px; cursor:pointer; line-height:1;
  }
  .modal-close:hover{color:var(--text);}

  /*Prefers Reduced Motion A11y */
  @media (prefers-reduced-motion: reduce){
    *, ::before, ::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    .ticker-track, .orbit-group { animation: none !important; }
  }

  /*Footer */
  footer{padding:40px 0; border-top:1px solid var(--border);}
  .foot-row{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px;}
  .foot-row .logo{color:var(--muted);}
  .foot-meta{font-family:var(--mono); font-size:12px; color:var(--muted);}
</style>
<script src="data/ecosystem.js"></script>
</head>
<body>

<noscript>
  <div class="noscript-banner">
    Notice: JavaScript is disabled in your browser. Interactive visualizers and real-time feeds require JavaScript.
  </div>
</noscript>

<!-- Topbar Navigation -->
<header class="topbar">
  <nav class="nav" aria-label="Main navigation">
    <div class="logo">
      <span class="dot" aria-hidden="true"></span>COSMOHUB
      <span class="badge">BUILDING IN PUBLIC</span>
    </div>
    <div class="navlinks">
      <a href="#gap">The Gap</a>
      <a href="#intelligence">Space Intelligence</a>
      <a href="#ontology">Ontology Graph</a>
      <a href="#board">Track Board</a>
      <a href="#roadmap">Roadmap</a>
    </div>
    <div class="nav-right">
      <a class="nav-cta" href="Pitch.html" aria-label="View the CosmoHub pitch deck">View Pitch Deck</a>
      <a class="nav-cta" href="#access">Join Early Access</a>
      <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-expanded="false" aria-controls="mobileDrawer" aria-label="Toggle navigation menu">MENU ☰</button>
    </div>
  </nav>
  <div class="mobile-drawer" id="mobileDrawer">
    <a href="#gap">The Gap</a>
    <a href="#intelligence">Space Intelligence</a>
    <a href="#ontology">Ontology Graph</a>
    <a href="#board">Track Board</a>
    <a href="#roadmap">Roadmap</a>
    <a href="Pitch.html" style="color:var(--cyan);">View Pitch Deck</a>
    <a href="#access" style="color:var(--amber);">Join Early Access</a>
  </div>
  <div class="ticker-bar" role="region" aria-label="Live signals ticker">
    <div class="ticker-track" id="tickerTrack" aria-live="polite"></div>
  </div>
</header>

<main>
  <!-- Hero Section -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">The Ontology for the Space Economy</div>
        <h1>Space has a market.<br>Now it has a <span class="accent">terminal</span>.</h1>
        <p class="hero-sub">
          CosmoHub is the <b>ontology-first intelligence platform</b> connecting space research institutes, universities, and missions directly with talent — <b>enthusiasts, students, and research fellows</b>.
        </p>
        <div class="hero-ctas">
          <a class="btn-primary" href="#access">Request Early Access</a>
          <a class="btn-ghost" href="Pitch.html">View Pitch Deck</a>
          <a class="btn-ghost" href="#ontology">Explore Ontology Graph</a>
        </div>
        <div class="metrics-strip">
          <div class="met-item">
            <div class="met-label">Signal Clock</div>
            <div class="met-val cyan" id="utcClock">--:--:--</div>
          </div>
          <div class="met-item">
            <div class="met-label">Product Stage</div>
            <div class="met-val amber">Prototype</div>
          </div>
          <div class="met-item">
            <div class="met-label">Current Focus</div>
            <div class="met-val" style="font-size:14px; line-height:22px;">Discovery + Learning</div>
          </div>
          <div class="met-item">
            <div class="met-label">Core Model</div>
            <div class="met-val" style="font-size:14px; line-height:22px;">Knowledge Graph</div>
          </div>
        </div>
      </div>

      <!-- Orbital Graphic Canvas -->
      <div class="orbit-wrap">
        <svg class="orbit-svg" viewBox="0 0 400 400" role="img" aria-labelledby="orbTitle orbDesc">
          <title id="orbTitle">Orbital Mechanics Visualizer</title>
          <desc id="orbDesc">Interactive animated rings showing satellites orbiting the CosmoHub nexus.</desc>
          <circle class="orbit-ring" cx="200" cy="200" r="65"></circle>
          <circle class="orbit-ring active" cx="200" cy="200" r="125"></circle>
          <circle class="orbit-ring" cx="200" cy="200" r="180"></circle>
          <text class="orbit-center-label" x="200" y="196" text-anchor="middle">COSMOHUB</text>
          <text class="orbit-sub-label" x="200" y="212" text-anchor="middle">ONTOLOGY NEXUS</text>

          <g class="orbit-group r1"><circle class="sat" cx="265" cy="200" r="5"></circle></g>
          <g class="orbit-group r2"><circle class="sat cyan" cx="325" cy="200" r="5.5"></circle></g>
          <g class="orbit-group r3"><circle class="sat" cx="380" cy="200" r="4"></circle></g>
          <g class="orbit-group r2" style="animation-delay:-10s;"><circle class="sat cyan" cx="75" cy="200" r="4.5"></circle></g>
        </svg>
      </div>
    </div>
  </section>

  <!-- The Gap Section -->
  <section class="section" id="gap">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">The Structural Dilemma</div>
        <h2>Unrouted talent. Unfulfilled space missions.</h2>
        <p>
          Space technology and satellite communications are advancing exponentially — yet entry paths remain scattered across obscure forums, disconnected PDFs, and informal networks.
        </p>
      </div>
      <div class="gap-toggle-bar">
        <button class="gap-btn active" id="btnGapCurrent" data-gap="current">Current Siloed Ecosystem</button>
        <button class="gap-btn" id="btnGapCosmo" data-gap="cosmohub">CosmoHub Signal Graph</button>
      </div>
      <div class="gap-visualizer" id="gapVisualizer">
        <div class="gap-card">
          <h4>Institutes &amp; Universities</h4>
          <p>Holding research papers, active space missions, and fellowship seats — but lacking targeted talent visibility.</p>
        </div>
        <div class="gap-arrow">
          <span id="gapArrowText">NO DIRECT SIGNAL</span>
          <div class="gap-line" aria-hidden="true"></div>
        </div>
        <div class="gap-card">
          <h4>Space Talent &amp; Fellows</h4>
          <p>High ambition and technical capability — but unable to discover institutional openings or prove skill alignment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Target Audience Segments -->
  <section class="section" id="audiences">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Target Segments</div>
        <h2>Three stages of the same space trajectory.</h2>
        <p>CosmoHub nurtures early interest into verified institutional contribution.</p>
      </div>
      <div class="grid-3">
        <div class="card-term">
          <div>
            <div class="term-head"><span>STAGE / 01</span><span class="code">LAUNCHPAD</span></div>
            <div class="term-body">
              <h3>Enthusiasts &amp; Kids</h3>
              <p>Plain-language explainers, real-time satellite pass trackers, and rocket mechanics modules that transform passive interest into real technical foundations.</p>
            </div>
          </div>
          <div class="term-body" style="padding-top:0;">
            <div class="term-tags"><span>Rocket Mechanics</span><span>Mission Trackers</span><span>Build Challenges</span></div>
          </div>
        </div>
        <div class="card-term">
          <div>
            <div class="term-head"><span>STAGE / 02</span><span class="code">COHORTS</span></div>
            <div class="term-body">
              <h3>Students &amp; Engineers</h3>
              <p>Structured, industry-mapped tracks in SATCOM, GNC, propulsion, and space policy with peer cohorts and verifiable project portfolios.</p>
            </div>
          </div>
          <div class="term-body" style="padding-top:0;">
            <div class="term-tags"><span>Industry Courses</span><span>Peer Cohorts</span><span>Verified Portfolios</span></div>
          </div>
        </div>
        <div class="card-term">
          <div>
            <div class="term-head"><span>STAGE / 03</span><span class="code">RESEARCH INDEX</span></div>
            <div class="term-body">
              <h3>Professionals &amp; Fellows</h3>
              <p>Direct fellowship query engines, institutional matching, and verified skill graphs that allow research groups to screen and recruit candidates instantly.</p>
            </div>
          </div>
          <div class="term-body" style="padding-top:0;">
            <div class="term-tags"><span>Fellowship Alerts</span><span>Graph Screening</span><span>Institute Matching</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Space Intelligence Section -->
  <section class="section" id="intelligence">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Space Intelligence</div>
        <h2>One signal layer for space news and research.</h2>
        <p>
          A prototype intelligence feed designed to bring together trusted space-sector updates,
          university research, papers, missions, and institutional announcements into a single queryable stream.
        </p>
      </div>
      <div class="intel-toolbar">
        <div class="intel-tabs">
          <button class="intel-tab active" data-intel="all">ALL SIGNALS</button>
          <button class="intel-tab" data-intel="news">SPACE NEWS</button>
          <button class="intel-tab" data-intel="research">RESEARCH &amp; ACADEMIA</button>
        </div>
        <div class="intel-status" id="intelStatus">PROTOTYPE FEED · 6 ACTIVE SIGNALS</div>
      </div>
      <div class="intel-grid" id="intelGrid"></div>
      <div class="source-strip">
        <span class="source-pill">PLANNED: SPACE AGENCIES</span>
        <span class="source-pill">PLANNED: UNIVERSITY LABS</span>
        <span class="source-pill">PLANNED: RESEARCH FEEDS</span>
        <span class="source-pill">PLANNED: MISSION UPDATES</span>
      </div>
    </div>
  </section>

  <!-- Interactive Ontology Graph Visualizer -->
  <section class="section" id="ontology">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">The Core Engine</div>
        <h2>An Ontology-First Knowledge Graph.</h2>
        <p>Explore a prototype knowledge graph showing how people, institutions, opportunities, learning tracks, and missions are connected in one discoverable system.</p>
      </div>
      <div class="ontology-container">
        <div class="ontology-canvas-wrap">
          <svg class="ontology-svg" viewBox="0 0 500 400" role="img" aria-labelledby="ontTitle ontDesc">
            <title id="ontTitle">Ontology Knowledge Graph Diagram</title>
            <desc id="ontDesc">Interactive diagram showing Person, Institute, Fellowship, Track, and Mission nodes connected by relational graph links.</desc>

            <!-- Relational Edges -->
            <line class="edge-line active" x1="250" y1="200" x2="100" y2="100" id="edge-person-institute"></line>
            <line class="edge-line active" x1="250" y1="200" x2="400" y2="100" id="edge-person-fellowship"></line>
            <line class="edge-line active" x1="250" y1="200" x2="100" y2="300" id="edge-person-track"></line>
            <line class="edge-line" x1="250" y1="200" x2="400" y2="300" id="edge-person-mission"></line>
            <line class="edge-line" x1="100" y1="100" x2="400" y2="100" id="edge-institute-fellowship"></line>

            <!-- Central Node: Person -->
            <g class="node-group" transform="translate(250,200)" data-node="Person" tabindex="0" role="button" aria-label="Inspect Person Node">
              <circle class="node-circle" id="node-Person" r="22" fill="#ffb627" stroke="#ffffff" stroke-width="2"></circle>
              <text class="node-text" y="34" text-anchor="middle">PERSON</text>
              <text class="node-sub" y="46" text-anchor="middle">Talent / Candidate</text>
            </g>
            <!-- Node: Institute -->
            <g class="node-group" transform="translate(100,100)" data-node="Institute" tabindex="0" role="button" aria-label="Inspect Institute Node">
              <circle class="node-circle" id="node-Institute" r="18" fill="#4ce0c6" stroke="#ffffff" stroke-width="1.5"></circle>
              <text class="node-text" y="28" text-anchor="middle">INSTITUTE</text>
            </g>
            <!-- Node: Fellowship -->
            <g class="node-group" transform="translate(400,100)" data-node="Fellowship" tabindex="0" role="button" aria-label="Inspect Fellowship Node">
              <circle class="node-circle" id="node-Fellowship" r="18" fill="#3b82f6" stroke="#ffffff" stroke-width="1.5"></circle>
              <text class="node-text" y="28" text-anchor="middle">FELLOWSHIP</text>
            </g>
            <!-- Node: Track -->
            <g class="node-group" transform="translate(100,300)" data-node="Track" tabindex="0" role="button" aria-label="Inspect Track Node">
              <circle class="node-circle" id="node-Track" r="18" fill="#141a27" stroke="#ffb627" stroke-width="2"></circle>
              <text class="node-text" y="28" text-anchor="middle">TRACK</text>
            </g>
            <!-- Node: Mission -->
            <g class="node-group" transform="translate(400,300)" data-node="Mission" tabindex="0" role="button" aria-label="Inspect Mission Node">
              <circle class="node-circle" id="node-Mission" r="18" fill="#141a27" stroke="#4ce0c6" stroke-width="2"></circle>
              <text class="node-text" y="28" text-anchor="middle">MISSION</text>
            </g>
          </svg>
        </div>

        <!-- Inspector Sidepanel -->
        <div class="ontology-inspector" id="nodeInspector" aria-live="polite">
          <div>
            <div class="inspector-header">
              <span>ONTOLOGY INSPECTOR</span>
              <span id="inspBadge" style="color:var(--amber);">OBJECT_CLASS</span>
            </div>
            <div class="inspector-title" id="inspTitle">PERSON</div>
            <div class="inspector-desc" id="inspDesc">Represents individual students, engineers, and research fellows in the space ecosystem. Linked to verified competencies and active applications.</div>
            <table class="inspector-prop-table">
              <tr><td class="key">Primary Key</td><td class="val" id="inspPk">person_uuid</td></tr>
              <tr><td class="key">Connected Links</td><td class="val" id="inspLinks">studies (Track), applies (Fellowship)</td></tr>
              <tr><td class="key">Verification Level</td><td class="val" id="inspVerif">Cryptographic Proof</td></tr>
              <tr><td class="key">Query Latency</td><td class="val">1.4ms</td></tr>
            </table>
          </div>
          <div style="font-family:var(--mono); font-size:11px; color:var(--muted);">
            Click or press enter on nodes in the diagram to inspect relational schemas.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Track Board Section -->
  <section class="section" id="board">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">The Board</div>
        <h2>Domain Tracks &amp; Signal Metrics.</h2>
        <p>A prototype view of the technical domains CosmoHub organizes into structured discovery and learning tracks.</p>
      </div>
      <div class="board-filter">
        <button class="filter-chip active" data-cat="all">ALL TRACKS</button>
        <button class="filter-chip" data-cat="comms">COMMS &amp; RF</button>
        <button class="filter-chip" data-cat="systems">SYSTEMS &amp; GNC</button>
        <button class="filter-chip" data-cat="policy">POLICY &amp; OPS</button>
      </div>
      <div class="index-grid" id="indexGrid"></div>
    </div>
  </section>

  <!-- Roadmap Section -->
  <section class="section" id="roadmap">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Execution Strategy</div>
        <h2>From focused prototype to connected ecosystem.</h2>
        <p>A staged product direction: validate the discovery problem first, then build the data and institutional layers that make the network useful.</p>
      </div>
      <div class="roadmap-grid">
        <div class="phase-card">
          <div class="phase-num">PHASE 01 // NOW</div>
          <h3>Signal &amp; Talent Graph</h3>
          <p>Validate the core problem, launch a focused prototype, and test whether learners and early-career talent use a structured space opportunity graph.</p>
          <ul class="phase-ul">
            <li>Launch the public prototype</li>
            <li>Interview learners and researchers</li>
            <li>Validate the first high-value use cases</li>
          </ul>
        </div>
        <div class="phase-card">
          <div class="phase-num">PHASE 02 // NEXT</div>
          <h3>Institutional Mesh</h3>
          <p>Build structured opportunity data and begin working with universities, labs, communities, and space organizations where there is clear mutual value.</p>
          <ul class="phase-ul">
            <li>Structured opportunity discovery</li>
            <li>Project and skill profiles</li>
            <li>Early institutional pilots</li>
          </ul>
        </div>
        <div class="phase-card">
          <div class="phase-num">PHASE 03 // VISION</div>
          <h3>Autonomous Space Terminal</h3>
          <p>Evolve into an intelligence layer that helps people navigate the space ecosystem and helps organizations discover relevant knowledge and talent.</p>
          <ul class="phase-ul">
            <li>Cross-ecosystem knowledge graph</li>
            <li>Research and talent matching</li>
            <li>Data-driven ecosystem intelligence</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Early Access Form -->
  <section class="section" id="access">
    <div class="wrap">
      <div class="cta-panel">
        <div>
          <div class="eyebrow">Early Access</div>
          <h2>Help shape the first version of CosmoHub.</h2>
          <p>CosmoHub is currently an early-stage prototype. If you are a student, engineer, researcher, educator, institution, or potential collaborator, share your details and tell us where you fit.</p>
        </div>
        <div>
          <form id="accessForm" action="#" method="POST">
            <div class="form-row">
              <div class="form-field">
                <label for="fullName">Full Name</label>
                <input type="text" id="fullName" name="full_name" placeholder="e.g. Kanti Mohanthy" required>
              </div>
              <div class="form-field">
                <label for="emailAddr">Email Address</label>
                <input type="email" id="emailAddr" name="email" placeholder="you@domain.com" required>
              </div>
              <div class="form-field">
                <label for="userRole">Primary Role / Stakeholder</label>
                <select id="userRole" name="role" required>
                  <option value="" disabled selected>Select option</option>
                  <option value="investor">Investor / Accelerator / Ecosystem Partner</option>
                  <option value="student">Student / Early-Career Engineer</option>
                  <option value="professional">Space Professional</option>
                  <option value="fellow">Researcher / Research Fellow</option>
                  <option value="institute">University / Research Institution</option>
                  <option value="community">Space Community / Educator</option>
                </select>
              </div>
              <button type="submit" class="submit-btn">JOIN EARLY ACCESS</button>
            </div>
            <div class="form-note">Prototype form — immediate confirmation provided.</div>
            <div class="form-success" id="formSuccess" role="status" aria-live="polite">✓ Thanks — your interest has been recorded in this prototype.</div>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- Footer -->
<footer>
  <div class="wrap foot-row">
    <div class="logo">
      <span class="dot" aria-hidden="true"></span>COSMOHUB TERMINAL
    </div>
    <div class="foot-meta">
      Early-stage prototype · Building the discovery layer for the space ecosystem
    </div>
  </div>
</footer>

<!-- Modal Backdrop & Dialog Box -->
<div class="modal-backdrop" id="trackModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-box">
    <button class="modal-close" id="modalCloseBtn" aria-label="Close modal">×</button>
    <div class="eyebrow" id="modalCode">SATCOM</div>
    <h2 id="modalTitle">Satellite Communications</h2>
    <p id="modalDesc" style="color:var(--muted); font-size:14px; margin-bottom:20px; line-height:1.5;">Detailed curriculum covering link budgets, RF design, constellation routing, and ground station operations.</p>
    <div style="background:var(--bg); border:1px solid var(--border); padding:16px; font-family:var(--mono); font-size:12px; margin-bottom:20px;">
      <div style="color:var(--amber); margin-bottom:6px;">SIGNAL METRICS</div>
      <div>Prototype Track Status: <span style="color:var(--cyan);" id="modalParam1">Exploration</span></div>
      <div>Planned Content: <span style="color:var(--cyan);" id="modalParam2">Curriculum + opportunities + projects</span></div>
      <div id="modalRelationships" style="margin-top: 10px; display: none;"></div>
    </div>
    <button class="btn-primary" style="width:100%;" id="modalConfirmBtn">CLOSE PREVIEW</button>
  </div>
</div>

<script>
  // Complete Valid NodeData Object & Robust Fallbacks
  const nodeData = {
    Person: {
      pk: 'person_uuid',
      title: 'PERSON (Talent Node)',
      desc: 'Represents individual students, engineers, and research fellows in the space ecosystem. Linked to verified competencies and active applications.',
      links: 'studies (Track), applies (Fellowship)',
      badge: 'TALENT_NODE',
      edges: ['edge-person-institute', 'edge-person-fellowship', 'edge-person-track']
    },
    Institute: {
      pk: 'institute_id',
      title: 'INSTITUTE (Academic / Lab)',
      desc: 'Space research institutes, university aerospace departments, and agencies providing academic fellowships and mission collaborations.',
      links: 'hosts (Fellowship), publishes (Mission)',
      badge: 'INSTITUTION_NODE',
      edges: ['edge-person-institute', 'edge-institute-fellowship']
    },
    Fellowship: {
      pk: 'fellowship_id',
      title: 'FELLOWSHIP (Opportunity)',
      desc: 'Funded research windows, lab seats, and grant positions offered directly by partner institutions.',
      links: 'offered_by (Institute), applied_by (Person)',
      badge: 'OPPORTUNITY_NODE',
      edges: ['edge-person-fellowship', 'edge-institute-fellowship']
    },
    Track: {
      pk: 'track_code',
      title: 'TRACK (Curriculum / Skill)',
      desc: 'Structured domain path (SATCOM, GNC, PROP) mapping core skills required for space missions.',
      links: 'prepares_for (Fellowship), followed_by (Person)',
      badge: 'CURRICULUM_NODE',
      edges: ['edge-person-track']
    },
    Mission: {
      pk: 'mission_id',
      title: 'MISSION (Real Space Payload)',
      desc: 'Active satellite constellations, planetary probes, and experimental payloads seeking technical contributors.',
      links: 'requires (Track), managed_by (Institute)',
      badge: 'MISSION_NODE',
      edges: ['edge-person-mission']
    }
  };

  function selectNode(type) {
    const data = nodeData[type] || {};
    document.getElementById('inspTitle').textContent = data.title || type.toUpperCase();
    document.getElementById('inspDesc').textContent = data.desc || 'No description available.';
    document.getElementById('inspPk').textContent = data.pk || '—';
    document.getElementById('inspLinks').textContent = data.links || '—';
    document.getElementById('inspBadge').textContent = data.badge || 'OBJECT_CLASS';

    // Highlight connected SVG edge lines dynamically
    document.querySelectorAll('.edge-line').forEach(line => line.classList.remove('active'));
    if(data.edges && Array.isArray(data.edges)){
      data.edges.forEach(edgeId => {
        const edge = document.getElementById(edgeId);
        if(edge) edge.classList.add('active');
      });
    }
  }

  // Domain Tracks Data
  const tracks = [
    { code: 'SATCOM', category: 'comms', name: 'Satellite Communications', signal: 'HIGH', path: 'M0,26 L14,20 L28,22 L42,12 L56,15 L70,6 L84,9 L98,2', color: 'var(--cyan)' },
    { code: 'GNC', category: 'systems', name: 'Guidance, Navigation & Control', signal: 'RISING', path: 'M0,20 L14,22 L28,16 L42,18 L56,10 L70,13 L84,7 L98,9', color: 'var(--amber)' },
    { code: 'PROP', category: 'systems', name: 'Propulsion Systems', signal: 'HIGH', path: 'M0,18 L14,14 L28,17 L42,10 L56,12 L70,5 L84,8 L98,3', color: 'var(--cyan)' },
    { code: 'SPACELAW', category: 'policy', name: 'Space Law & Policy', signal: 'RISING', path: 'M0,24 L14,21 L28,23 L42,17 L56,19 L70,11 L84,14 L98,8', color: 'var(--amber)' },
    { code: 'GRDSYS', category: 'comms', name: 'Ground Systems & RF', signal: 'HIGH', path: 'M0,16 L14,19 L28,13 L42,15 L56,9 L70,11 L84,6 L98,4', color: 'var(--cyan)' },
    { code: 'REMSNS', category: 'systems', name: 'Remote Sensing', signal: 'RISING', path: 'M0,22 L14,17 L28,19 L42,13 L56,16 L70,9 L84,12 L98,6', color: 'var(--amber)' },
    { code: 'SPACEMED', category: 'policy', name: 'Space Biology & Medicine', signal: 'HIGH', path: 'M0,19 L14,15 L28,18 L42,11 L56,14 L70,7 L84,10 L98,5', color: 'var(--cyan)' },
    { code: 'MISSOPS', category: 'policy', name: 'Mission Operations', signal: 'RISING', path: 'M0,17 L14,20 L28,14 L42,16 L56,10 L70,12 L84,7 L98,4', color: 'var(--amber)' }
  ];

  function renderBoard(filter = 'all'){
    const grid = document.getElementById('indexGrid');
    if(!grid) return;
    const filtered = filter === 'all' ? tracks : tracks.filter(t => t.category === filter);
    grid.innerHTML = filtered.map(tr => `
      <div class="idx-card" data-code="${tr.code}" data-name="${tr.name}" tabindex="0" role="button" aria-label="View ${tr.name} track details">
        <div class="idx-top">
          <span class="idx-code">${tr.code}</span>
          <span class="idx-signal ${tr.signal === 'HIGH' ? 'high' : 'rising'}">${tr.signal}</span>
        </div>
        <div class="idx-name">${tr.name}</div>
        <svg class="idx-spark" viewBox="0 0 100 30" preserveAspectRatio="none">
          <path d="${tr.path}" stroke="${tr.color}"></path>
        </svg>
      </div>
    `).join('');

    // Attach clean click listeners to dynamically created track cards
    grid.querySelectorAll('.idx-card').forEach(card => {
      card.addEventListener('click', () => {
        openModal(
          card.dataset.code,
          card.dataset.name,
          'Detailed curriculum covering link budgets, RF design, constellation routing, and ground station operations.',
          'Active Track',
          'Curriculum + Projects'
        );
      });
      card.addEventListener('keydown', (e) => {
        if(e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.click();
        }
      });
    });
  }

  // Space Intelligence Prototype Feed
  const sampleIntelligence = ecosystemData.entities.map(e => ({
    type: e.type === "Publication" ? "research" : "news",
    source: e.type.toUpperCase(),
    date: e.date || "VERIFIED RECORD",
    title: e.name || e.title || `Financial Event: ${e.eventType}`,
    summary: e.assetClass || e.orgType || e.pubType || e.eventType || "Entity Record",
    originalEntity: e
  }));

  function renderIntelligence(filter = 'all'){
    const grid = document.getElementById('intelGrid');
    if(!grid) return;
    const items = filter === 'all' ? sampleIntelligence : sampleIntelligence.filter(x => x.type === filter);
    if(!items.length){
      grid.innerHTML = '<div class="intel-empty">NO SIGNALS AVAILABLE FOR THIS FILTER.</div>';
      return;
    }
    grid.innerHTML = items.map((item, idx) => `
      <article class="intel-card" data-idx="${idx}" tabindex="0" role="button" aria-label="Read ${item.title}">
        <div class="intel-meta"><span class="intel-source">${item.source}</span><span>${item.date}</span></div>
        <h3>${item.title}</h3>
        <p>${item.summary}</p>
        <span class="intel-link">VIEW SIGNAL METRICS →</span>
      </article>
    `).join('');

    // Attach event listeners
    grid.querySelectorAll('.intel-card').forEach(card => {
      card.addEventListener('click', () => {
        const item = items[card.dataset.idx];
        if(item){
          openModal(item.source, item.title, item.summary, item.type.toUpperCase(), item.date, item.originalEntity);
        }
      });
      card.addEventListener('keydown', (e) => {
        if(e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.click();
        }
      });
    });
  }

  // Ticker bar renderer
  const tickerItems = [
    { t: 'COSMOHUB', s: 'prototype live', cls: 'up', arrow: '▲' },
    { t: 'SATCOM', s: 'domain map active', cls: 'up', arrow: '▲' },
    { t: 'GNC', s: 'learning path concept', cls: '', arrow: '' },
    { t: 'RESEARCH OPPORTUNITIES', s: 'discovery layer active', cls: 'up', arrow: '▲' },
    { t: 'SPACE LAW', s: 'policy track added', cls: '', arrow: '' },
    { t: 'KNOWLEDGE GRAPH', s: '5 core nodes linked', cls: 'up', arrow: '▲' }
  ];

  function renderTicker(){
    const track = document.getElementById('tickerTrack');
    if(!track) return;
    const html = tickerItems.map(i =>
      `<span><b>${i.t}</b> ${i.s} ${i.arrow ? `<span class="${i.cls}">${i.arrow}</span>` : ''}</span>`
    ).join('');
    track.innerHTML = html + html;
  }

  // UTC Live Signal Clock
  function tickClock(){
    const el = document.getElementById('utcClock');
    if(!el) return;
    const now = new Date();
    const hh = String(now.getUTCHours()).padStart(2,'0');
    const mm = String(now.getUTCMinutes()).padStart(2,'0');
    const ss = String(now.getUTCSeconds()).padStart(2,'0');
    el.textContent = `${hh}:${mm}:${ss} UTC`;
  }

  // Modal Open/Close & Focus Management
  let previousActiveElement = null;

  function openModal(code, title, desc, p1 = 'Active', p2 = 'Curriculum & Research', entity = null){
    previousActiveElement = document.activeElement;
    document.getElementById('modalCode').textContent = code;
    document.getElementById('modalTitle').textContent = title;
    document.getElementById('modalDesc').textContent = desc;
    document.getElementById('modalParam1').textContent = p1;
    document.getElementById('modalParam2').textContent = p2;

    const relsDiv = document.getElementById('modalRelationships');
    if (entity && typeof ecosystemData !== 'undefined') {
      const rels = ecosystemData.relationships.filter(r => r.source === entity.id || r.target === entity.id);
      if (rels.length > 0) {
        let html = '<div style="color:var(--amber); margin-bottom:6px; margin-top:12px;">RELATIONSHIPS</div>';
        rels.forEach(r => {
          const otherId = r.source === entity.id ? r.target : r.source;
          const otherEnt = ecosystemData.entities.find(e => e.id === otherId);
          if (otherEnt) {
            const name = otherEnt.name || otherEnt.title || `${otherEnt.eventType} (${otherEnt.value})`;
            let prov = "";
            if (r.properties && r.properties.confidence) {
              let sourceLink = "";
              if (r.properties.source_id) {
                const src = ecosystemData.entities.find(x => x.id === r.properties.source_id);
                if (src && src.url) sourceLink = ` <a href="${src.url}" target="_blank" style="color:var(--cyan); text-decoration:underline;">[Source]</a>`;
              }
              prov = ` <span style="color:var(--muted); font-size:10px;">[${r.properties.confidence}]</span>${sourceLink}`;
            }

            html += `<div>${r.type}: <span style="color:var(--cyan);">${name} (${otherEnt.type})</span>${prov}</div>`;
          }
        });
        relsDiv.innerHTML = html;
        relsDiv.style.display = 'block';
      } else {
        if (relsDiv) relsDiv.style.display = 'none';
      }
    } else {
      if (relsDiv) relsDiv.style.display = 'none';
    }

    const modal = document.getElementById('trackModal');
    modal.style.display = 'flex';
    document.getElementById('modalConfirmBtn').focus();
  }

  function closeModal(){
    const modal = document.getElementById('trackModal');
    modal.style.display = 'none';
    if(previousActiveElement) previousActiveElement.focus();
  }

  // Single DOMContentLoaded Listener for all Event Wiring (No inline handlers)
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Initial Renderings
    renderTicker();
    tickClock();
    setInterval(tickClock, 1000);
    renderBoard('all');
    renderIntelligence('all');

    // 2. Mobile Menu Toggle
    const mobileToggle = document.getElementById('mobileMenuToggle');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(mobileToggle && mobileDrawer){
      mobileToggle.addEventListener('click', () => {
        const expanded = mobileToggle.getAttribute('aria-expanded') === 'true';
        mobileToggle.setAttribute('aria-expanded', !expanded);
        mobileDrawer.classList.toggle('active');
      });
      mobileDrawer.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileDrawer.classList.remove('active');
          mobileToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // 3. Gap Section Toggle Buttons
    const btnGapCurr = document.getElementById('btnGapCurrent');
    const btnGapCosmo = document.getElementById('btnGapCosmo');
    const arrowText = document.getElementById('gapArrowText');
    if(btnGapCurr && btnGapCosmo && arrowText){
      btnGapCurr.addEventListener('click', () => {
        btnGapCurr.classList.add('active');
        btnGapCosmo.classList.remove('active');
        arrowText.textContent = 'NO DIRECT SIGNAL';
        arrowText.style.color = 'var(--amber)';
      });
      btnGapCosmo.addEventListener('click', () => {
        btnGapCosmo.classList.add('active');
        btnGapCurr.classList.remove('active');
        arrowText.textContent = 'COSMOHUB SIGNAL GRAPH';
        arrowText.style.color = 'var(--cyan)';
      });
    }

    // 4. Board Filter Buttons (Clean Data Attribute Listeners)
    document.querySelectorAll('.board-filter .filter-chip').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.board-filter .filter-chip').forEach(c => c.classList.remove('active'));
        e.currentTarget.classList.add('active');
        const category = e.currentTarget.dataset.cat || 'all';
        renderBoard(category);
      });
    });

    // 5. Space Intelligence Filter Tabs
    document.querySelectorAll('.intel-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.intel-tab').forEach(t => t.classList.remove('active'));
        e.currentTarget.classList.add('active');
        const filter = e.currentTarget.dataset.intel || 'all';
        renderIntelligence(filter);
      });
    });

    // 6. SVG Ontology Node Click & Keydown Listeners
    document.querySelectorAll('.ontology-svg .node-group').forEach(group => {
      const nodeType = group.dataset.node;
      if(nodeType){
        group.addEventListener('click', () => selectNode(nodeType));
        group.addEventListener('keydown', (e) => {
          if(e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            selectNode(nodeType);
          }
        });
      }
    });

    // 7. Modal Dismiss Handlers
    const modalBackdrop = document.getElementById('trackModal');
    const modalCloseBtn = document.getElementById('modalCloseBtn');
    const modalConfirmBtn = document.getElementById('modalConfirmBtn');

    if(modalBackdrop) {
      modalBackdrop.addEventListener('click', (e) => {
        if(e.target === modalBackdrop) closeModal();
      });
    }
    if(modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if(modalConfirmBtn) modalConfirmBtn.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if(e.key === 'Escape') closeModal();
    });

    // 8. Access Form Handler
    const accessForm = document.getElementById('accessForm');
    const formSuccess = document.getElementById('formSuccess');
    if(accessForm && formSuccess){
      accessForm.addEventListener('submit', (e) => {
        e.preventDefault();
        formSuccess.style.display = 'block';
        accessForm.reset();
      });
    }
  });
</script>
</body>
</html>
